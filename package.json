{
  "name": "addon-bone-site",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "rspress build",
    "dev": "rspress dev",
    "preview": "rspress preview",
    "check": "biome check . && npm run check:snippets",
    "format": "biome format --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:search": "node --experimental-strip-types --test plugins/mdx-search-index/mdx-search-index.test.ts",
    "prepare": "husky",
    "check:fix": "biome check --write . && npm run check:snippets -- --fix",
    "check:snippets": "node scripts/check-snippets.mjs",
    "test:tooling": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@rspress/core": "2.0.2",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@mdx-js/mdx": "3.1.1",
    "@rsbuild/plugin-sass": "^1.5.0",
    "@shikijs/transformers": "3.22.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rspress-plugin-file-tree": "^1.0.4",
    "sass": "^1.97.3",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --",
      "node scripts/check-snippets.mjs --fix"
    ]
  }
}
